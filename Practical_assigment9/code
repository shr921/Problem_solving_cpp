#include <iostream>
#include <string>
#include <utility>
using namespace std;

// User-defined class
class Student {
public:
    string name;
    string branch;

    Student(string n, string b) {
        name = n;
        branch = b;
    }

    void display() {
        cout << "Name: " << name << endl;
        cout << "Branch: " << branch << endl;
    }
};

int main() {
    int choice;

    cout << "===== STD::MOVE DEMONSTRATION =====\n";
    cout << "1. Built-in example (String)\n";
    cout << "2. User-defined data type (Student)\n";
    cout << "Enter your choice: ";
    cin >> choice;
    cin.ignore();

    if (choice == 1) {
        string str1, str2;

        cout << "\nEnter a string: ";
        getline(cin, str1);

        str2 = move(str1);

        cout << "\nAfter std::move():\n";
        cout << "Source string: " << str1 << endl;
        cout << "Destination string: " << str2 << endl;
    }

    else if (choice == 2) {
        string name, branch;

        cout << "\nEnter student name: ";
        getline(cin, name);

        cout << "Enter student branch: ";
        getline(cin, branch);

        Student s1(name, branch);
        Student s2("", "");

        // Moving user-defined object
        s2 = move(s1);

        cout << "\nAfter std::move():\n";

        cout << "\nSource object:\n";
        s1.display();

        cout << "\nDestination object:\n";
        s2.display();
    }

    else {
        cout << "Invalid choice!";
    }

    return 0;
}
